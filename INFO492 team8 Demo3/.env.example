# Copy to Render → Environment (web + worker). Never commit real keys.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Persistent app state on Render disk (match render.yaml)
DEMO3_RUNTIME=/var/data/runtime

# Public demo guardrails
MAX_AI_CALLS_PER_DAY=200
AI_RATE_LIMIT_PER_IP=15

# Background worker: issue next addendum on this interval (seconds)
WATCH_EVERY_SECONDS=86400

# Optional
DEMO_START_ADDENDUM=1
DEMO_TODAY=2023-09-15
